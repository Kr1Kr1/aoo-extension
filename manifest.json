{
  "manifest_version": 3,
  "name": "Age of Olympia Tracker",
  "version": "1.2",
  "description": "Suivez l'évolution de vos stats sur Age of Olympia.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://localhost:4200/*",
    "http://localhost:9000/*",
    "https://age-of-olympia.net/*",
    "https://am.i.mullvad.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
  },
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" },
  "content_scripts": [
    {
      "matches": ["https://age-of-olympia.net/*", "http://localhost:9000/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["https://age-of-olympia.net/*", "http://localhost:9000/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "aootracker@example.com",
      "strict_min_version": "121.0"
    }
  }
}
